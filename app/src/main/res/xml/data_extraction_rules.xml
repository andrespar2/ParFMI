<?xml version="1.0" encoding="utf-8"?>
<!-- Sin copias de seguridad: la app no debe respaldar identificadores de
     dispositivos ni la API key del proveedor en la nube de Android. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" />
        <exclude domain="file" />
        <exclude domain="database" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" />
        <exclude domain="file" />
        <exclude domain="database" />
    </device-transfer>
</data-extraction-rules>
