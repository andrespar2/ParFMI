    <!-- Acerca de -->
    <string name="about_title">Acerca de ParFMI</string>
    <string name="about_app_name">Aplicacion: ParFMI</string>
    <string name="about_version">Version %1$s (%2$d)</string>
    <string name="about_description">ParFMI consulta el estado de Find My iPhone (FMI) y otros datos de seguridad de dispositivos Apple a partir de su IMEI o numero de serie. Es una herramienta de verificacion previa a la compra o de diagnostico: no modifica el dispositivo ni intenta eludir ninguna proteccion.</string>
    <string name="about_developer_label">Desarrollado por</string>
    <string name="about_developer">andrespar2</string>
    <string name="about_github_label">GitHub</string>
    <string name="about_github_url">https://github.com/andrespar2</string>
    <string name="about_repo_label">Repositorio del proyecto</string>
    <string name="about_repo_url">https://github.com/andrespar2/ParFMI</string>
    <string name="about_releases_label">Descargas (Releases)</string>
    <string name="about_credits_title">Creditos</string>
    <string name="about_credits_text">Desarrollo, diseno y documentacion: andrespar2.\nDatos proporcionados por el proveedor de consultas configurado por el usuario.\nParFMI no esta afiliada a Apple Inc. Apple, iPhone y Find My son marcas de Apple Inc. y se mencionan solo con fines descriptivos.</string>
    <string name="about_legal_title">Alcance y limites</string>
    <string name="about_legal_text">ParFMI es exclusivamente de consulta. No ofrece funciones para omitir, desbloquear o desactivar FMI ni Activation Lock. Los resultados dependen por completo del proveedor configurado: si un dato no esta disponible, la app lo indica como \"No disponible\" y nunca lo inventa.</string>
