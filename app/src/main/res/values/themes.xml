<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Tema base: fondo negro AMOLED puro, sin barra de accion. -->
    <style name="Theme.ParFMI" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/amoled_black</item>
        <item name="android:colorBackground">@color/amoled_black</item>
        <item name="android:statusBarColor">@color/amoled_black</item>
        <item name="android:navigationBarColor">@color/amoled_black</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:colorAccent">@color/parfmi_red</item>
    </style>
</resources>
